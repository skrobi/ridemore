# Skopiuj do .env (obok tego pliku) i wypełnij — .env NIE powinien trafić do
# repo/backupu (na razie ridemore.bike nie jest repo gita, ale zasada zostaje).

# groq / gemini (chmura, różne limity) albo ollama (lokalnie, bez limitu, bez
# klucza — patrz providers/ollama_provider.py).
AI_PROVIDER=groq

# --- Groq (console.groq.com/keys) ---
GROQ_API_KEY=
# Opcjonalnie — inny model niż wbudowany domyślny (patrz DEFAULT_MODEL w
# providers/groq_provider.py). Mniejsze modele mają wyższy limit TPM.
GROQ_MODEL=llama-3.1-8b-instant

# --- Gemini (aistudio.google.com/apikey) ---
# Dużo wyższe limity TOKENÓW niż darmowy tier Groq (patrz
# providers/gemini_provider.py), ALE limity LICZBY zapytań na darmowym tierze
# bywają bardzo wąskie i NIERÓWNE między modelami na tym samym koncie —
# sprawdzone żywo 2026-08-07: gemini-2.5-flash w ogóle niedostępny dla
# nowych kont (HTTP 404), gemini-2.0-flash miał limit 0 (brak darmowego
# dostępu na tym koncie), gemini-flash-latest (aktualnie gemini-3.6-flash)
# limit 20 zapytań. `gemini-flash-latest`/`gemini-pro-latest` to ALIASY,
# które Google przekierowuje na aktualnie obsługiwany model — bezpieczniejszy
# domyślny wybór niż wpisywanie konkretnej wersji na sztywno. Jeśli łapiesz
# "Quota exceeded ... limit: 0" na jakimś modelu — na TYM koncie ten model
# nie ma darmowego dostępu, spróbuj innego albo poczekaj na reset licznika.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Ollama (lokalnie, AI_PROVIDER=ollama) ---
# Wymaga uruchomionego `ollama serve` i pobranego modelu (`ollama pull <nazwa>`).
# Sprawdź, co już masz: `ollama list` — i wpisz DOKŁADNIE tę nazwę niżej
# (z tagiem, jeśli podano, np. "llama3.1:8b"). Bez tego dostaniesz czytelny
# błąd "Ollama nie zna modelu ...", nie ciche niepowodzenie.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
