# Skopiuj do .env (obok tego pliku) i wypełnij prawdziwym kluczem —
# .env NIE powinien trafić do repo/backupu (patrz .gitignore obok, jeśli
# projekt używa gita; na razie ridemore.bike nie jest repo gita).

# groq / gemini (chmura, limity różne dla różnych tierów) albo ollama
# (lokalnie, bez limitu, bez klucza — patrz providers/ollama_provider.py).
# Przełączanie nie wymaga restartu niczego, patrz README.md.
AI_PROVIDER=gemini

# --- Groq (console.groq.com/keys) ---
GROQ_API_KEY=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
# llama-3.3-70b-versatile było tu wcześniej ustawione i regularnie łapało
# HTTP 413 (limit TPM za mały na 70B na darmowym tierze, patrz README.md
# "Rozwiązywanie problemów") — z powrotem na 8B, zgodnie z DEFAULT_MODEL
# w providers/groq_provider.py. Na tym koncie darmowy tier ma tylko 6000
# TPM — ciasno nawet po przycięciu payloadu (analyze.py::_prioritize_links),
# stąd dodany trzeci dostawca (gemini) niżej.
GROQ_MODEL=llama-3.1-8b-instant

# --- Gemini (aistudio.google.com/apikey) — dodane 2026-08-07 ---
# Dużo wyższe limity TOKENÓW niż darmowy tier Groq (1M/65k na modelach
# flash), ale limity LICZBY zapytań/dzień na darmowym tierze są NIERÓWNE
# między modelami na TYM koncie i KAŻDY model ma WŁASNY, niezależny licznik
# — sprawdzone żywo 2026-08-07: gemini-2.5-flash/gemini-2.5-flash-lite to
# HTTP 404 ("no longer available to new users" mimo że są na liście
# modeli!), gemini-2.0-flash i gemini-2.0-flash-lite to limit 0,
# gemini-flash-latest (alias -> gemini-3.6-flash) limit 20/dzień (user
# wyczerpał go tego samego dnia realnym użyciem wtyczki — "Quota exceeded"
# w panelu to WŁAŚNIE to, nie błąd kodu). gemini-3.1-flash-lite ZADZIAŁAŁ ze
# świeżym, osobnym licznikiem — obecny wybór. Jeśli TEN wyczerpiesz, próbuj
# innych modeli z `GET /v1beta/models?key=...` — każdy ma swój licznik,
# resetujący się (prawdopodobnie) co 24h. Payload i tak przycinany
# (provider-agnostycznie, patrz analyze.py), ale dla Gemini to dużo mniej
# krytyczne niż dla Groq.
GEMINI_API_KEY=AQ.Ab8RN6J2h1WVpGvkCz6MwczKB7GkgyChjXVYJtvcDGrapeRV0A
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Ollama (lokalnie, AI_PROVIDER=ollama) ---
# Wymaga uruchomionego `ollama serve` (na Windows startuje z appką w tray,
# patrz Ollama app.exe) i pobranego modelu (`ollama pull <nazwa>`).
# qwen3:8b i llama3.1:8b (Q4_K_M) obie zawiodły na realnej, złożonej stronie
# w testach z 2026-08-07 (patrz ai-engine/README.md) — Groq/Gemini są na
# razie sprawdzoną ścieżką dla realnych stron, nie Ollama.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
